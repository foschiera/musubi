{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "editorial_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["schema_version", "version", "title", "editorial_note"]
}
