{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^evt_[a-z0-9_]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "date": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "end": {
            "type": "string",
            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "precision": {
            "enum": ["year", "month", "day"]
          },
          "circa": {
            "type": "boolean"
          }
        },
        "required": ["start", "end", "precision", "circa"]
      },
      "region_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "narratives": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "perspective_id": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["id", "perspective_id", "language", "text", "source_ids"]
        }
      },
      "location": {
        "type": "string",
        "minLength": 1
      },
      "layout": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": ["x", "y"]
      }
    },
    "required": [
      "id",
      "title",
      "summary",
      "date",
      "region_ids",
      "source_ids",
      "narratives",
      "location",
      "layout"
    ]
  }
}
